# Sao chép file này thành .env rồi chỉnh lại.

# --- Database -----------------------------------------------------------------
# SQLite (local). Khi lên internet: postgresql://user:pass@host:5432/cinextma
DATABASE_URL="file:./data/cinextma.db"

# --- Auth ---------------------------------------------------------------------
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# URL chính của site (dùng cho cookie, link email...). Ví dụ: http://cinextma.local
BETTER_AUTH_URL="http://localhost:3000"
# Các origin khác được phép đăng nhập (cách nhau dấu phẩy), ví dụ truy cập qua IP LAN
TRUSTED_ORIGINS="http://localhost:3000,http://cinextma.local"
# Cho phép người xem tự đăng ký tài khoản
ALLOW_SIGNUP="true"

# Tài khoản admin được tạo khi chạy `npm run db:seed`
ADMIN_EMAIL="admin@cinextma.local"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="Quản trị viên"

# --- Media --------------------------------------------------------------------
# Thư mục lưu video, ảnh, phụ đề. Nên đặt ở ổ đĩa nhiều dung lượng.
#   <MEDIA_ROOT>/public  -> phục vụ tại /media/*  (HLS, ảnh, phụ đề)
#   <MEDIA_ROOT>/private -> file gốc và file đang upload (không public)
MEDIA_ROOT="./storage"
# Giữ lại file video gốc sau khi xử lý xong (để xử lý lại sau này)
KEEP_ORIGINALS="true"

# Đường dẫn ffmpeg/ffprobe (để trống nếu đã có trong PATH)
FFMPEG_PATH=""
FFPROBE_PATH=""

# yt-dlp: lấy video từ link website khác (Admin → Thêm phim → Lấy từ link). Để trống nếu có trong PATH.
YTDLP_PATH=""
# Deno: yt-dlp cần để tải từ YouTube (winget install DenoLand.Deno)
DENO_PATH=""
# Chrome/Edge để tự dò link .m3u8 khi trang tạo link bằng JavaScript (video dạng blob:). Để trống: tự tìm Chrome rồi Edge.
CHROME_PATH=""
# Bộ mã hoá H.264: libx264 (CPU) | h264_nvenc (NVIDIA) | h264_qsv (Intel) | h264_amf (AMD)
VIDEO_ENCODER="libx264"
# Các độ phân giải tạo ra khi transcode (chỉ tạo những mức <= độ phân giải gốc)
TRANSCODE_HEIGHTS="1080,720,480"
# Chạy worker xử lý video ngay trong tiến trình web (false nếu chạy `npm run worker` riêng)
WORKER_ENABLED="true"

# --- Tuỳ chọn -----------------------------------------------------------------
# TMDB API Read Access Token (v4) — dùng cho tính năng "Import từ TMDB" trong admin
TMDB_ACCESS_TOKEN=""
