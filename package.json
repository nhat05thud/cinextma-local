{
  "name": "cinextma",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "video:import": "tsx scripts/import-video.ts",
    "icons:sync": "tsx scripts/sync-icons.ts"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@heroui/react": "^2.8.10",
    "@hookform/resolvers": "^5.2.1",
    "@iconify/react": "^6.0.0",
    "@mantine/hooks": "^8.2.4",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.85.3",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "@videojs/hlsjs-video": "^10.2.0",
    "@videojs/react": "^10.2.0",
    "better-auth": "^1.7.15",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.12",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-share": "^5.2.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "string-ts": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-motion": "^1.1.1",
    "tmdb-ts": "^2.0.2",
    "tus-js-client": "^4.3.1",
    "use-long-press": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prettier": {
    "proseWrap": "never",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "@heroui/shared-utils@2.1.12": true
  }
