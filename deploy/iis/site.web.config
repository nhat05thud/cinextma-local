<?xml version="1.0" encoding="UTF-8"?>
<!--
  Site IIS cho Cinextma: reverse proxy mọi request tới Next.js (127.0.0.1:3000),
  trừ /media/* do IIS phục vụ trực tiếp từ virtual directory (xem media.web.config).
  Cần: IIS URL Rewrite 2.1 + Application Request Routing 3.0 (setup-iis.ps1 tự cài).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Cinextma reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/media/" negate="true" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapProto:{HTTPS}}" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <!-- IP thật của người xem (không kèm cổng, ghi đè giá trị client tự gửi) cho Better Auth -->
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:__APP_PORT__/{R:1}" />
        </rule>
      </rules>
      <rewriteMaps>
        <rewriteMap name="MapProto">
          <add key="on" value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Mỗi chunk upload (tus) là 50MB; để dư 200MB -->
        <requestLimits maxAllowedContentLength="209715200" maxUrl="8192" maxQueryString="8192" />
      </requestFiltering>
    </security>
    <!-- Next.js tự nén và stream HTML; IIS nén lại sẽ làm vỡ streaming -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
