<?xml version="1.0" encoding="UTF-8"?>
<!--
  Đặt vào <MEDIA_ROOT>\public\web.config (setup-iis.ps1 tự chép).
  IIS phục vụ thẳng file HLS / ảnh / phụ đề, có hỗ trợ Range, không qua Node.js.
  Không khai báo <handlers> ở đây: section này bị IIS khoá mặc định -> lỗi 500.19.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".m3u8" />
      <mimeMap fileExtension=".m3u8" mimeType="application/vnd.apple.mpegurl" />
      <remove fileExtension=".ts" />
      <mimeMap fileExtension=".ts" mimeType="video/mp2t" />
      <remove fileExtension=".m4s" />
      <mimeMap fileExtension=".m4s" mimeType="video/iso.segment" />
      <remove fileExtension=".vtt" />
      <mimeMap fileExtension=".vtt" mimeType="text/vtt; charset=utf-8" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
    </staticContent>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
